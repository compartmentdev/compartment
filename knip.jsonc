{
  "includeEntryExports": true,
  "ignore": [
    ".codex/skills/**/scripts/**/*.mjs",
    "examples/**",
    "public-docs/src/styles/site.css",
    // Release workflows run this helper by string path from shell steps.
    "scripts/deploy/list-self-hosted-runtime-image-artifacts.mjs",
    // CLI smoke starts this helper through a string path passed to Node spawn.
    "packages/cli/test/support/fake-oidc-server.ts",
    // Docs generation shells through repo-local tsx and passes this runner by string path.
    "scripts/docs/public-docs/run-typescript-export.mjs",
    "scripts/dev/run-compartment-cli.mjs",
    "packages/contracts/src/index.browser.ts",
    // Browser-safe utils entry is consumed through the Vite alias in packages/console/vite.config.ts.
    "packages/utils/src/browser.ts",
    // Kept intentionally as a reference implementation for future auth loading UX work.
    "packages/console/src/features/auth/auth-loading-screen.tsx",
  ],
  "ignoreBinaries": ["astro", "dotenv", "vite"],
  "ignoreDependencies": [
    "@compartment/eslint-config",
    "@vercel/ncc",
    "dotenv-cli",
    "postject",
    "shadcn",
    "tailwindcss",
    "tw-animate-css",
  ],
  "ignoreIssues": {
    // Public descriptor/service config types are part of the contracts package API even when only external consumers use them.
    "packages/contracts/src/contracts/compartment-descriptor.contract.ts": ["types"],
    "packages/contracts/src/index.misc.ts": ["types"],
    "packages/contracts/src/index.ts": ["types"],
    // Git-provider registration contracts are public API for external clients; pass 2 adds in-repo UI consumers.
    "packages/contracts/src/contracts/control-plane-browser-errors.contract.ts": ["exports"],
    "packages/contracts/src/contracts/control-plane-protocol.contract.ts": ["exports"],
    "packages/contracts/src/contracts/source-git-provider.contract.ts": ["exports", "types"],
    "packages/contracts/src/index.browser-git.ts": ["exports", "types"],
    // These SDK methods are the public client surface for the backend routes.
    "packages/sdk/src/index.ts": ["exports"],
    "packages/sdk/src/services/source-git.service.ts": ["exports"],
  },
  "entry": [
    "package.json",
    "eslint.config.mjs!",
    "eslint.duplicates.config.mjs!",
    "scripts/deploy/list-self-hosted-runtime-image-artifacts.mjs!",
    "scripts/dev/run-compartment-cli.mjs!",
    "scripts/docs/public-docs/generate-public-docs.mjs!",
    "scripts/docs/public-docs/run-typescript-export.mjs!",
    "packages/contracts/src/index.browser.ts!",
  ],
  "project": [
    "*.config.{js,cjs,mjs,ts,mts}",
    "scripts/**/*.mjs",
    "packages/eslint-config/**/*.mjs",
    "packages/eslint-plugin/**/*.mjs",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/drizzle.config.ts",
  ],
  "workspaces": {
    "packages/api": {
      "entry": ["src/server.ts!"],
      "project": ["src/**/*.ts", "test/**/*.ts", "drizzle.config.ts"],
    },
    "packages/console": {
      // Entry points are declared explicitly below, so Knip does not need to execute Vite config here.
      "vite": false,
      "entry": ["src/index.ts!", "src/main.tsx!", "src/auth-main.tsx!"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.mts"],
    },
    "packages/cli": {
      "entry": ["src/bin.ts!"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/worker": {
      // registry-auth-proxy is launched by docker-compose through dist/registry-auth-proxy.js.
      "entry": ["src/index.ts!", "src/server.ts!", "src/registry-auth-proxy.ts!"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/edge": {
      "entry": ["src/server.ts!", "scripts/sync-caddyfile.mjs!", "scripts/sync-caddyfile.impl.ts!"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "scripts/**/*.ts", "test/**/*.ts"],
    },
    "packages/eslint-config": {
      "entry": ["repo.mjs!", "duplicates.mjs!"],
      "project": ["*.mjs", "test/**/*.mjs"],
    },
    "packages/eslint-plugin": {
      "entry": ["index.mjs!"],
      "project": ["index.mjs", "rules/**/*.mjs", "test/**/*.mjs"],
    },
  },
}

{
  "name": "compartment",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "dev": "dotenv -e .env -- node ./scripts/dev/start-dev.mjs",
    "docs:dev": "pnpm docs:generate && pnpm --dir public-docs dev",
    "docs:build": "pnpm docs:generate && pnpm --dir public-docs build",
    "docs:generate": "node ./scripts/docs/public-docs/generate-public-docs.mjs",
    "docs:check": "node ./scripts/docs/public-docs/check-public-docs.mjs",
    "dev:caddy": "dotenv -e .env -- node ./scripts/dev/run-caddy.mjs",
    "dev:registry": "dotenv -e .env -- node ./scripts/dev/ensure-dev-artifact-registry.mjs",
    "self-hosted:publish": "node ./scripts/deploy/publish-self-hosted-images.mjs",
    "platform:e2e:up": "node ./scripts/deploy/platform-k3d-e2e.mjs up",
    "platform:e2e:down": "node ./scripts/deploy/platform-k3d-e2e.mjs down",
    "platform:e2e:run": "node ./scripts/deploy/run-platform-k3d-e2e-shard.mjs",
    "broker:deploy:prod": "node ./scripts/deploy/deploy-broker-prod.mjs",
    "release:prepare": "node ./scripts/release/prepare.mjs",
    "cli:build:sea": "node ./scripts/release/build-cli-sea.mjs",
    "cli:build:sea:source": "node ./scripts/release/build-cli-sea.mjs --distribution-channel source",
    "cli:render:installer": "node ./scripts/release/render-cli-install-script.mjs",
    "prebuild": "node ./scripts/build/clean-package-build-outputs.mjs",
    "build": "turbo run build",
    "build:test": "turbo run build:test",
    "lint:scripts": "eslint --config eslint.config.mjs --max-warnings 0 --cache --cache-location .eslintcache \"scripts/**/*.mjs\" \".codex/skills/**/scripts/**/*.mjs\"",
    "lint:root-config": "eslint --config eslint.config.mjs --max-warnings 0 --cache --cache-location .eslintcache .husky/install.mjs commitlint.config.cjs eslint.config.mjs eslint.duplicates.config.mjs lint-staged.config.mjs prettier.config.mjs vitest.config.mts vitest.coverage.all.config.mts vitest.db.config.mts vitest.deploy-e2e.config.mts vitest.setup.mts",
    "lint:root": "pnpm lint:scripts && pnpm lint:root-config",
    "lint:examples": "eslint --config eslint.config.mjs --max-warnings 0 --cache --cache-location .eslintcache \"examples/**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint": "pnpm lint:root && pnpm lint:examples && turbo run lint",
    "lint:ci": "pnpm lint:root && pnpm lint:examples && pnpm -r --if-present --filter \"@compartment/*\" lint",
    "typecheck:scripts": "node ./scripts/ci/check-scripts-runtime.mjs",
    "typecheck": "pnpm typecheck:scripts && turbo run typecheck",
    "test:scripts": "vitest run --config ./vitest.config.mts --dir ./scripts",
    "test": "pnpm test:scripts && turbo run test",
    "test:fast:ci": "pnpm test",
    "test:db": "dotenv -e .env -e .env.test.local -- vitest run --config ./vitest.db.config.mts",
    "test:integration": "pnpm test:db",
    "test:ci": "pnpm test:scripts && turbo run test --force --concurrency=1 && pnpm test:db",
    "test:coverage": "vitest run --config ./vitest.config.mts --dir packages --passWithNoTests --coverage",
    "test:coverage:all": "dotenv -e .env -e .env.test.local -- vitest run --config ./vitest.coverage.all.config.mts --dir packages --passWithNoTests --coverage",
    "compartment": "dotenv -e .env -- tsx --tsconfig ./packages/cli/tsconfig.json ./packages/cli/src/bin.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:no-cyrillic": "node ./scripts/ci/check-no-cyrillic.mjs",
    "check:duplicates": "pnpm check:duplicates:eslint && pnpm check:duplicates:cpd",
    "check:duplicates:cpd": "jscpd --config .jscpd.json --format typescript,javascript,markup,css packages scripts public-docs .husky/install.mjs commitlint.config.cjs eslint.config.mjs eslint.duplicates.config.mjs lint-staged.config.mjs prettier.config.mjs vitest.config.mts vitest.coverage.all.config.mts vitest.db.config.mts vitest.deploy-e2e.config.mts vitest.setup.mts",
    "check:duplicates:eslint": "eslint --config eslint.duplicates.config.mjs --cache --cache-location .eslintcache-duplicates .",
    "check:unused": "knip --reporter compact",
    "check:unused:runtime": "knip --production --strict --include exports,types --reporter compact --config knip.runtime.jsonc",
    "check:commitlint": "node ./scripts/ci/check-commitlint.mjs",
    "check:kubernetes-cutover": "node ./scripts/ci/check-kubernetes-cutover.mjs",
    "check:fork-pr-runners": "node ./scripts/ci/check-fork-pr-runners.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm build:test && pnpm test && pnpm check:commitlint && pnpm check:kubernetes-cutover && pnpm check:fork-pr-runners && pnpm check:unused && pnpm check:unused:runtime",
    "check:ci:fast": "pnpm lint:ci && pnpm typecheck && pnpm build && pnpm build:test && pnpm test:fast:ci && pnpm check:commitlint && pnpm check:kubernetes-cutover && pnpm check:fork-pr-runners && pnpm format:check && pnpm docs:check && pnpm check:unused && pnpm check:unused:runtime && pnpm check:duplicates && pnpm check:no-cyrillic",
    "check:ci": "pnpm check:ci:fast && pnpm test:db",
    "db:check": "pnpm --filter @compartment/api db:check",
    "db:generate": "pnpm --filter @compartment/api db:generate",
    "db:migrate": "pnpm --filter @compartment/api db:migrate",
    "db:reset": "pnpm --filter @compartment/api db:reset",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^3.0.7",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "6.6.0",
    "lint-staged": "^16.4.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yaml": "2.8.3"
  }
}

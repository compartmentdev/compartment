    compartment.dev/checksum: <sha256>
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/secret-id: sec-01jz
  name: secret-sec-01jz-a55b0604f5214e41
  namespace: cpt-prj-01jz-243118a73be1a00d
stringData:
  DATABASE_URL: postgres://db/app
  TOKEN: secret
type: Opaque"
`;

exports[`Kubernetes manifest projection goldens > projects an application row to the T1 and T2 workload bundle 1`] = `
"apiVersion: v1
kind: Secret
metadata:
  annotations:
    compartment.dev/checksum: <sha256>
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/secret-id: sec-01jz
  name: secret-sec-01jz-a55b0604f5214e41
  namespace: cpt-prj-01jz-243118a73be1a00d
stringData:
  FEATURE_FLAG: enabled
  LOG_LEVEL: info
type: Opaque
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    compartment.dev/environment-name: Production
    compartment.dev/organization-name: Acme
    compartment.dev/project-name: Checkout
    compartment.dev/service-name: Web
  labels: &a1
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: app-dep-01jz-271c08c7e603c156
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  progressDeadlineSeconds: 45
  replicas: 2
  selector:
    matchLabels: *a1
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      annotations:
        compartment.dev/environment-name: Production
        compartment.dev/organization-name: Acme
        compartment.dev/project-name: Checkout
        compartment.dev/secret-checksum: <sha256>
        compartment.dev/service-name: Web
      labels: *a1
    spec:
      automountServiceAccountToken: false
      containers:
        - env:
            - name: FEATURE_FLAG
              valueFrom:
                secretKeyRef:
                  key: FEATURE_FLAG
                  name: secret-sec-01jz-a55b0604f5214e41
            - name: LOG_LEVEL
              valueFrom:
                secretKeyRef:
                  key: LOG_LEVEL
                  name: secret-sec-01jz-a55b0604f5214e41
          image: registry.example/app@sha256:abc
          lifecycle:
            preStop:
              exec:
                command:
                  - sh
                  - -c
                  - sleep 3
          name: app
          ports:
            - containerPort: 8080
              name: http
              protocol: TCP
          readinessProbe:
            failureThreshold: 3
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 1
            periodSeconds: 2
            successThreshold: 1
            timeoutSeconds: 1
      terminationGracePeriodSeconds: 45
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    compartment.dev/environment-name: Production
    compartment.dev/organization-name: Acme
    compartment.dev/project-name: Checkout
    compartment.dev/service-name: Web
  labels: &a1
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: app-dep-01jz-271c08c7e603c156
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  ports:
    - name: http
      port: 80
      protocol: TCP
      targetPort: 8080
  selector: *a1
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: np-default-deny-dep-01jz-271c08c7e603c156
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels: &a1
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: np-ingress-dep-01jz-271c08c7e603c156
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              compartment.dev/namespace-id: platform-01jz
          podSelector:
            matchLabels:
              app.kubernetes.io/name: caddy
      ports:
        - port: 8080
          protocol: TCP
  podSelector:
    matchLabels: *a1
  policyTypes:
    - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels: &a1
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: np-egress-dep-01jz-271c08c7e603c156
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  egress:
    - ports:
        - port: 53
          protocol: UDP
        - port: 53
          protocol: TCP
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
              - 169.254.0.0/16
              - 10.42.0.0/16
              - 10.43.0.0/16
  podSelector:
    matchLabels: *a1
  policyTypes:
    - Egress"
`;

exports[`Kubernetes manifest projection goldens > projects a secret row without a service-account token 1`] = `
"apiVersion: v1
kind: Secret
metadata:
  annotations:
    compartment.dev/checksum: <sha256>
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/secret-id: sec-01jz
  name: secret-sec-01jz-a55b0604f5214e41
  namespace: cpt-prj-01jz-243118a73be1a00d
stringData:
  DATABASE_URL: postgres://db/app
  TOKEN: secret
type: Opaque"
`;

exports[`Kubernetes manifest projection goldens > projects an application row to the T1 workload bundle 1`] = `
"apiVersion: v1
kind: Secret
metadata:
  annotations:
    compartment.dev/checksum: <sha256>
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/secret-id: sec-01jz
  name: secret-sec-01jz-a55b0604f5214e41
  namespace: cpt-prj-01jz-243118a73be1a00d
stringData:
  FEATURE_FLAG: enabled
  LOG_LEVEL: info
type: Opaque
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    compartment.dev/environment-name: Production
    compartment.dev/organization-name: Acme
    compartment.dev/project-name: Checkout
    compartment.dev/service-name: Web
  labels:
    app.kubernetes.io/managed-by: compartment
    compartment.dev/deployment-id: dep-01jz
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: app-env-01jz-svc-01jz-6a4f00bb0d302109
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  progressDeadlineSeconds: 45
  replicas: 2
  selector:
    matchLabels: &a1
      app.kubernetes.io/managed-by: compartment
      compartment.dev/environment-id: env-01jz
      compartment.dev/organization-id: org-01jz
      compartment.dev/project-id: prj-01jz
      compartment.dev/service-id: svc-01jz
  strategy:
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
    type: RollingUpdate
  template:
    metadata:
      annotations:
        compartment.dev/environment-name: Production
        compartment.dev/organization-name: Acme
        compartment.dev/project-name: Checkout
        compartment.dev/secret-checksum: <sha256>
        compartment.dev/service-name: Web
      labels: *a1
    spec:
      automountServiceAccountToken: false
      containers:
        - env:
            - name: FEATURE_FLAG
              valueFrom:
                secretKeyRef:
                  key: FEATURE_FLAG
                  name: secret-sec-01jz-a55b0604f5214e41
            - name: LOG_LEVEL
              valueFrom:
                secretKeyRef:
                  key: LOG_LEVEL
                  name: secret-sec-01jz-a55b0604f5214e41
          image: registry.example/app@sha256:abc
          lifecycle:
            preStop:
              exec:
                command:
                  - sh
                  - -c
                  - sleep 3
          name: app
          ports:
            - containerPort: 8080
              name: http
              protocol: TCP
          readinessProbe:
            failureThreshold: 3
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 1
            periodSeconds: 2
            successThreshold: 1
            timeoutSeconds: 1
      imagePullSecrets:
        - name: secret-pull-01jz-6be17b2de1a41fc5
      terminationGracePeriodSeconds: 45
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    compartment.dev/environment-name: Production
    compartment.dev/organization-name: Acme
    compartment.dev/project-name: Checkout
    compartment.dev/service-name: Web
  labels: &a1
    app.kubernetes.io/managed-by: compartment
    compartment.dev/environment-id: env-01jz
    compartment.dev/organization-id: org-01jz
    compartment.dev/project-id: prj-01jz
    compartment.dev/service-id: svc-01jz
  name: app-env-01jz-svc-01jz-6a4f00bb0d302109
  namespace: cpt-prj-01jz-243118a73be1a00d
spec:
  ports:
    - name: http
      port: 80
      protocol: TCP
      targetPort: 8080
  selector: *a1"
`;

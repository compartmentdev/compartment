{
  "name": "@compartment/kube-runtime",
  "version": "0.10.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifests",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test:network-policy": "bash test/network-policy-enforcement-check.sh",
    "test:network-policy:render": "tsx test/network-policy-enforcement-render.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@compartment/utils": "workspace:*",
    "@kubernetes/client-node": "^1.4.0"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*",
    "yaml": "^2.8.1"
  }
}

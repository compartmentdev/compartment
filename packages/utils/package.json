{
  "name": "@compartment/utils",
  "version": "0.11.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "metrics": [
        "dist/prometheus-metrics.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/prometheus-metrics.d.ts",
      "default": "./dist/prometheus-metrics.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*"
  }
}

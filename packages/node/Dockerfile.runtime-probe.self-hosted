# syntax=docker/dockerfile:1.7

ARG COMPARTMENT_NODE_RUNTIME_IMAGE=node:24.14.0-bookworm-slim

FROM ${COMPARTMENT_NODE_RUNTIME_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/compartmentdev/compartment"

RUN apt-get update \
  && apt-get upgrade --yes --no-install-recommends \
  && apt-get install --yes --no-install-recommends ca-certificates \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
  && rm -rf /var/lib/apt/lists/*

USER node
WORKDIR /tmp

CMD ["node", "--version"]

{
  "name": "@compartment/node",
  "version": "0.8.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts --exclude ./test/runtime-network-boundary.docker.test.ts",
    "test:docker-boundary": "vitest run --config ../../vitest.config.mts ./test/runtime-network-boundary.docker.test.ts",
    "test:integration": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@compartment/contracts": "workspace:*",
    "@compartment/docker": "workspace:*",
    "@compartment/sdk": "workspace:*",
    "@compartment/utils": "workspace:*",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*",
    "@compartment/test-support": "workspace:*"
  }
}

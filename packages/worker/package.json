{
  "name": "@compartment/worker",
  "version": "0.9.2",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts",
    "test:e2e": "vitest run --config ../../vitest.deploy-e2e.config.mts"
  },
  "dependencies": {
    "@compartment/contracts": "workspace:*",
    "@compartment/docker": "workspace:*",
    "@compartment/kube-runtime": "workspace:*",
    "@compartment/source-archive": "workspace:*",
    "@compartment/sdk": "workspace:*",
    "@compartment/utils": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/rest": "^22.0.1",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*"
  }
}

{
  "name": "@compartment/api",
  "version": "0.11.0",
  "private": true,
  "exports": {},
  "files": [
    "dist",
    "drizzle",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../.. && tsc -p tsconfig.vitest.json --noEmit",
    "test": "vitest run --config ./vitest.package.config.mts --no-file-parallelism",
    "db:check": "dotenv -e ../../.env -- tsx src/db/check.ts",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "dotenv -e ../../.env -- tsx src/db/migrate.ts",
    "db:reset": "dotenv -e ../../.env -- tsx src/db/reset.ts"
  },
  "dependencies": {
    "@compartment/console": "workspace:*",
    "@compartment/contracts": "workspace:*",
    "@compartment/utils": "workspace:*",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.1",
    "@lukeed/ms": "^2.0.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "argon2": "^0.44.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "execa": "10.0.0",
    "fastify": "^5.8.5",
    "openid-client": "^6.8.3",
    "pg": "^8.13.3",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.9",
    "tldts": "^7.0.28",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*",
    "@compartment/test-support": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}

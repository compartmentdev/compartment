{
  "name": "@compartment/console",
  "version": "0.4.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "browser-dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "dev": "pnpm --filter @compartment/contracts build && vite build --watch --config vite.config.ts",
    "build": "pnpm run build:browser && tsc -p tsconfig.build.json",
    "build:browser": "pnpm --filter @compartment/contracts build && vite build --config vite.config.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts --no-file-parallelism",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@compartment/contracts": "workspace:*",
    "@compartment/utils": "workspace:*",
    "@tanstack/react-query": "5.100.11"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.3",
    "zod": "^3.24.2"
  }
}

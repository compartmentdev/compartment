{
  "name": "@compartment/edge",
  "version": "0.10.4",
  "private": true,
  "exports": {},
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --tsconfig tsconfig.json src/server.ts",
    "caddyfile:write": "node ./scripts/sync-caddyfile.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts",
    "test:go": "go -C caddy-ratelimit test -race ./... && go -C caddy-traffic-metering test -race ./...",
    "vet:go": "go -C caddy-ratelimit vet ./... && go -C caddy-traffic-metering vet ./..."
  },
  "dependencies": {
    "@compartment/contracts": "workspace:*",
    "@compartment/sdk": "workspace:*",
    "@compartment/utils": "workspace:*",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*"
  }
}

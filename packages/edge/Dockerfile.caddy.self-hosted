# syntax=docker/dockerfile:1.7

ARG COMPARTMENT_CADDY_BUILDER_IMAGE=caddy:2.11-builder
ARG COMPARTMENT_CADDY_RUNTIME_IMAGE=alpine:3.22

FROM ${COMPARTMENT_CADDY_BUILDER_IMAGE} AS builder

RUN xcaddy build v2.11.4 --with google.golang.org/grpc@v1.82.1

FROM ${COMPARTMENT_CADDY_RUNTIME_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/compartmentdev/compartment"

ENV XDG_CONFIG_HOME=/config \
  XDG_DATA_HOME=/data

RUN apk upgrade --no-cache \
  && apk add --no-cache ca-certificates libcap mailcap \
  && mkdir -p /config /data

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy
COPY packages/edge/Caddyfile /etc/caddy/Caddyfile

ENTRYPOINT ["/usr/bin/caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

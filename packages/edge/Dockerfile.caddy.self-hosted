# syntax=docker/dockerfile:1.7

ARG COMPARTMENT_CADDY_BUILDER_IMAGE=caddy:2.11.4-builder
ARG COMPARTMENT_CADDY_RUNTIME_IMAGE=alpine:3.22

FROM ${COMPARTMENT_CADDY_BUILDER_IMAGE} AS builder

WORKDIR /src

COPY packages/edge/caddy-dns-compartment-broker ./packages/edge/caddy-dns-compartment-broker

RUN xcaddy build v2.11.4 \
    --with github.com/compartmentdev/compartment/packages/edge/caddy-dns-compartment-broker=./packages/edge/caddy-dns-compartment-broker

FROM ${COMPARTMENT_CADDY_RUNTIME_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/compartmentdev/compartment"

ENV XDG_CONFIG_HOME=/config \
  XDG_DATA_HOME=/data

RUN apk upgrade --no-cache \
  && apk add --no-cache ca-certificates libcap mailcap \
  && mkdir -p /config /data

COPY --from=builder /src/caddy /usr/bin/caddy
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy
COPY packages/edge/Caddyfile.custom-cert /etc/caddy/Caddyfile.custom-cert
COPY packages/edge/Caddyfile.custom-http /etc/caddy/Caddyfile.custom-http
COPY packages/edge/Caddyfile.internal /etc/caddy/Caddyfile.internal
COPY packages/edge/Caddyfile.managed /etc/caddy/Caddyfile.managed
COPY --chmod=755 packages/edge/caddy-entrypoint.sh /usr/bin/compartment-caddy-entrypoint

VOLUME /data /config

ENTRYPOINT ["/usr/bin/compartment-caddy-entrypoint"]

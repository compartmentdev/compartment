{
	admin {$COMPARTMENT_CADDY_ADMIN_ADDR:localhost:2019}
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:{$COMPARTMENT_CADDY_HTTP_PORT} {
	vars public_scheme http
	@ingress_https header X-Forwarded-Proto https
	vars @ingress_https public_scheme https
	request_header -Forwarded
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-For

	@compartment_host host console.{$COMPARTMENT_BASE_DOMAIN}
	handle @compartment_host {
		route {
			@compartment_public_paths path / /activate /audit /login /login/cli /login/cli/completed /logout /onboarding /reset-password /v1/auth/activate /v1/auth/activate-state /v1/auth/cli/exchange /v1/auth/cli/start /v1/auth/cli/status /v1/auth/login /v1/auth/login-discovery /v1/auth/login-state /v1/auth/logout /v1/auth/reset-password /v1/auth/reset-password-state /v1/auth/settings /v1/audit/events /v1/audit/events/export /v1/install /v1/orgs /v1/organizations /v1/organizations/settings /v1/source-uploads /v1/whoami /browser-assets /browser-assets/* /login/sso /login/sso/* /groups /groups/* /projects /projects/* /roles /roles/* /users /users/* /v1/assignments /v1/assignments/* /v1/deployments /v1/deployments/* /v1/onboarding/first-deploy /v1/onboarding/first-deploy/* /v1/groups /v1/groups/* /v1/roles /v1/roles/* /v1/sources /v1/sources/* /v1/sso/oidc/providers /v1/sso/oidc/providers/* /v1/domains /v1/domains/* /v1/projects /v1/projects/* /v1/resources /v1/resources/* /v1/users /v1/users/* /v1/variables /v1/variables/* /v1/variable-groups /v1/variable-groups/* /orgs/* /_compartment/domain/probe/* /v1/resource-backups/*
			handle @compartment_public_paths {
				reverse_proxy {$COMPARTMENT_API_INTERNAL_HOST}:{$COMPARTMENT_API_PORT} {
					header_up X-Forwarded-Host {host}
					header_up X-Forwarded-Proto {vars.public_scheme}
					header_up X-Forwarded-For {client_ip}
				}
			}

			handle {
				respond 404
			}
		}
	}

	@application_host host *.{$COMPARTMENT_BASE_DOMAIN}
	handle @application_host {
		route {
			@compartment_edge_paths path /_compartment/callback /_compartment/logout
			handle @compartment_edge_paths {
				reverse_proxy {$COMPARTMENT_EDGE_INTERNAL_HOST}:{$COMPARTMENT_EDGE_PORT} {
					header_up X-Forwarded-Host {host}
					header_up X-Forwarded-Proto {vars.public_scheme}
					header_up X-Forwarded-For {client_ip}
				}
			}

			request_header -X-Compartment-*

			forward_auth {$COMPARTMENT_EDGE_INTERNAL_HOST}:{$COMPARTMENT_EDGE_PORT} {
				uri /internal/ingress/authorize
				header_up Host {host}
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {vars.public_scheme}
				header_up X-Forwarded-For {client_ip}
				copy_headers {
					X-Compartment-Access-Mode
					X-Compartment-Organization-Id
					X-Compartment-Organization-Slug
					X-Compartment-Principal-Email
					X-Compartment-Principal-Id
					X-Compartment-Principal-Type
					X-Compartment-Proxy-Path
					X-Compartment-Upstream-Host
					X-Compartment-Upstream-Port
				}
			}

			@compartment_proxy_path header_regexp compartment_proxy_path X-Compartment-Proxy-Path ^/.*$
			rewrite @compartment_proxy_path {header.X-Compartment-Proxy-Path}

			reverse_proxy {header.X-Compartment-Upstream-Host}:{header.X-Compartment-Upstream-Port} {
				header_up Cookie "(^|; *)(?:__Host-compartment_|__Secure-compartment_|compartment_)[^=;]+=[^;]*" "$1"
				header_up Cookie "(; *)(; *)+" "$1"
				header_up Cookie "^; *(.*)$" "$1"
				header_up Cookie "^(.*?); *$" "$1"
				header_down Set-Cookie "^ *(?:__Host-compartment_|__Secure-compartment_|compartment_)[^=;]+=.*$" ""
				header_up X-Forwarded-Host {host}
				header_up X-Forwarded-Proto {vars.public_scheme}
				header_up X-Forwarded-For {client_ip}
				header_up -X-Compartment-Proxy-Path
				header_up -X-Compartment-Upstream-Host
				header_up -X-Compartment-Upstream-Port
			}
		}
	}

	handle {
		respond 404
	}
}

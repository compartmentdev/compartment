{
  "name": "@compartment/contracts",
  "version": "0.5.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "dist/index.browser.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.. && tsc -p tsconfig.test.json --noEmit --rootDir ../..",
    "test": "vitest run --config ../../vitest.config.mts",
    "test:contracts": "vitest run --config ../../vitest.config.mts test"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@compartment/eslint-config": "workspace:*"
  }
}

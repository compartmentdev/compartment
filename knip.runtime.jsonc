{
  // Runtime-only dead code check.
  // This intentionally ignores test usage and looks only at production/runtime entrypoints.
  "includeEntryExports": true,
  "entry": [
    "scripts/deploy/list-self-hosted-runtime-image-artifacts.mjs!",
    "scripts/deploy/manage-platform-image-cache-lock.mjs!",
    "scripts/deploy/run-platform-k3d-e2e-shard.mjs!",
    // The shard runner starts these executable gates by validated repo-local paths.
    "scripts/deploy/collect-platform-k3d-e2e-diagnostics.mjs!",
    "scripts/deploy/run-platform-k3d-product-log-gate.mjs!",
    "scripts/deploy/run-platform-k3d-retained-state-gate.mjs!",
    "scripts/dev/run-compartment-cli.mjs!",
    "packages/contracts/src/index.browser.ts!",
  ],
  "ignore": [
    "packages/*/dist/**",
    // Browser-safe utils entry is consumed through the Vite alias in packages/console/vite.config.ts.
    "packages/utils/src/browser.ts",
  ],
  "ignoreBinaries": ["astro", "dotenv"],
  "ignoreDependencies": ["dotenv-cli"],
  "ignoreIssues": {
    // These broker request schemas are public contract validators for broker implementations outside this workspace.
    "packages/contracts/src/contracts/managed-domain.contract.ts": ["exports"],
    // DNS-01 presentation and replay are public SDK operations consumed by the solver and external broker clients.
    "packages/sdk/src/index.ts": ["exports"],
    "packages/sdk/src/services/managed-domain.service.ts": ["exports"],
  },
  "ignoreWorkspaces": ["packages/test-support", "packages/eslint-config", "packages/eslint-plugin"],
  "workspaces": {
    "packages/api": {
      "entry": ["src/server.ts!", "src/db/check.ts!", "src/db/migrate.ts!", "src/db/reset.ts!"],
      "project": ["src/**/*.ts!", "drizzle.config.ts!", "!test/**!"],
    },
    "packages/docker": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/kube-runtime": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/cli": {
      "entry": ["src/bin.ts!"],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/contracts": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/source-archive": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/console": {
      // Runtime entry points are declared explicitly below, so Knip does not need to execute Vite config here.
      "vite": false,
      "entry": ["src/index.ts!", "src/main.tsx!", "src/auth-main.tsx!"],
      "project": ["src/**/*.ts!", "src/**/*.tsx!", "!test/**!"],
    },
    "packages/edge": {
      "entry": ["src/server.ts!", "scripts/sync-caddyfile.mjs!", "scripts/sync-caddyfile.impl.ts!"],
      "project": ["src/**/*.ts!", "scripts/sync-caddyfile.impl.ts!", "scripts/**/*.mjs!", "!test/**!"],
    },
    "packages/worker": {
      "entry": [
        "src/index.ts!",
        "src/server.ts!",
        "src/build-job.ts!",
        "src/registry-auth-proxy.ts!",
        "src/registry-install-verifier.ts!",
        "src/project-provisioner-server.ts!",
        "src/project-provisioner-job.ts!",
      ],
      "project": ["src/**/*.ts!", "!test/**!"],
    },
    "packages/sdk": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"],
    },
    "packages/utils": {
      "entry": ["src/index.ts!", "src/browser.ts!", "src/text.ts!"],
      "project": ["src/**/*.ts!"],
    },
  },
}

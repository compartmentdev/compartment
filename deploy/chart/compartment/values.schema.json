{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "images": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/definitions/platformImage" },
        "worker": { "$ref": "#/definitions/platformImage" },
        "edge": { "$ref": "#/definitions/platformImage" },
        "caddy": { "$ref": "#/definitions/platformImage" },
        "dns01Solver": { "$ref": "#/definitions/platformImage" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "endpoint", "targetsJson"],
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "type": "string", "enum": ["", "A", "AAAA", "hostname"] },
            "value": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "" } } },
              "then": { "properties": { "value": { "const": "" } } }
            },
            {
              "if": { "properties": { "type": { "const": "A" } } },
              "then": { "properties": { "value": { "format": "ipv4" } } }
            },
            {
              "if": { "properties": { "type": { "const": "AAAA" } } },
              "then": { "properties": { "value": { "format": "ipv6" } } }
            },
            {
              "if": { "properties": { "type": { "const": "hostname" } } },
              "then": {
                "properties": {
                  "value": {
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.?$"
                  }
                }
              }
            }
          ]
        },
        "targetsJson": { "type": "string", "pattern": "^\\[" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerRef", "existingSecret", "acme", "solver"],
      "properties": {
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] }
          }
        },
        "existingSecret": { "type": "string" },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "productionUrl", "stagingUrl", "skipTlsVerify"],
          "properties": {
            "environment": { "type": "string", "enum": ["staging", "production"] },
            "productionUrl": { "type": "string", "pattern": "^https://" },
            "stagingUrl": { "type": "string", "pattern": "^https://" },
            "skipTlsVerify": { "type": "boolean" }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groupName"],
          "properties": {
            "groupName": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)+$"
            }
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "edge", "registry", "registryInternal", "buildkit", "http"],
      "properties": {
        "api": { "$ref": "#/definitions/tcpPort" },
        "edge": { "$ref": "#/definitions/tcpPort" },
        "registry": { "$ref": "#/definitions/tcpPort" },
        "registryInternal": { "$ref": "#/definitions/tcpPort" },
        "buildkit": { "$ref": "#/definitions/tcpPort" },
        "http": { "$ref": "#/definitions/tcpPort" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterIP", "hostname", "issuerRef"],
      "properties": {
        "clusterIP": {
          "oneOf": [{ "const": "" }, { "type": "string", "format": "ipv4" }]
        },
        "hostname": {
          "type": "string",
          "pattern": "^$|^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "kind", "name"],
          "properties": {
            "group": { "const": "cert-manager.io" },
            "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] },
            "name": { "type": "string" }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "startupStage",
        "domainGeneration",
        "domainCommit",
        "installationId",
        "managedDomainAllocationId",
        "domainMode",
        "baseDomain",
        "publicProtocol",
        "tlsMode",
        "acmeIssuer",
        "acmeCaUrl",
        "acmeEmail",
        "managedDomainBrokerUrl"
      ],
      "properties": {
        "startupStage": { "type": "string", "enum": ["foundation", "full"] },
        "domainGeneration": { "type": "integer", "minimum": 0 },
        "domainCommit": { "type": "boolean" },
        "installationId": { "type": "string" },
        "managedDomainAllocationId": { "type": "string" },
        "domainMode": { "type": "string", "enum": ["custom", "managed"] },
        "baseDomain": { "type": "string" },
        "publicProtocol": { "type": "string", "enum": ["http", "https"] },
        "tlsMode": { "type": "string", "enum": ["broker-dns01", "internal", "issuer"] },
        "acmeIssuer": { "type": "string", "enum": ["acme"] },
        "acmeCaUrl": { "type": "string", "pattern": "^https://[^/?#@]+(/[^?#]*)?$" },
        "acmeEmail": {
          "type": "string",
          "oneOf": [{ "const": "" }, { "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" }]
        },
        "managedDomainBrokerUrl": {
          "oneOf": [{ "const": "" }, { "type": "string", "pattern": "^https?://[^/?#@]+/?$" }]
        },
        "rollbackRetentionLimit": {
          "description": "Maximum retained rollback images inherited by organizations. Leave empty for indefinite retention.",
          "oneOf": [{ "const": "" }, { "type": "integer", "minimum": 1 }]
        },
        "authThrottle": {
          "description": "Authentication throttle windows, limits, and cooldowns.",
          "type": "object",
          "additionalProperties": false,
          "required": ["login", "activation", "passwordReset"],
          "properties": {
            "login": {
              "description": "Login throttles by route, source, account, and source-account pair.",
              "$ref": "#/definitions/loginAuthThrottle"
            },
            "activation": {
              "description": "Account activation throttles by route, source, subject, and source-subject pair.",
              "$ref": "#/definitions/subjectAuthThrottle"
            },
            "passwordReset": {
              "description": "Password-reset throttles by route, source, subject, and source-subject pair.",
              "$ref": "#/definitions/subjectAuthThrottle"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "installToken": { "type": "string" },
        "managedDomainBrokerToken": { "type": "string" },
        "registryCredentialSigningKey": {
          "oneOf": [{ "const": "" }, { "type": "string", "minLength": 32 }]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false
    },
    "nodePools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "build", "tenant"],
      "properties": {
        "system": { "$ref": "#/definitions/nodePool" },
        "build": { "$ref": "#/definitions/nodePool" },
        "tenant": { "$ref": "#/definitions/nodePool" }
      }
    },
    "buildkit": {
      "type": "object",
      "required": [
        "enabled",
        "namespace",
        "gcKeepStorageMb",
        "pruneSchedule",
        "pruneKeepDuration",
        "podCidr",
        "serviceCidr"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "gcKeepStorageMb": { "type": "integer", "minimum": 1 },
        "pruneSchedule": { "type": "string", "minLength": 1 },
        "pruneKeepDuration": { "type": "string", "minLength": 1 },
        "workerNamespaceSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "workerPodSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "dnsNamespaceSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "dnsPodSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "podCidr": { "type": "string", "minLength": 1 },
        "serviceCidr": { "type": "string", "minLength": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "properties": {
        "snapshots": {
          "type": "object",
          "required": ["enabled", "mountPath"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": { "edgeSnapshots": { "type": "string", "minLength": 1 } }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["platform"],
        "properties": {
          "platform": {
            "required": ["domainMode"],
            "properties": { "domainMode": { "const": "managed" } }
          }
        }
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "issuerRef": {
                "properties": { "kind": { "const": "Issuer" } }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "tcpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeSelector", "tolerations"],
      "properties": {
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "effect": { "type": "string", "enum": ["NoExecute", "NoSchedule", "PreferNoSchedule"] },
              "key": { "type": "string" },
              "operator": { "type": "string", "enum": ["Equal", "Exists"] },
              "tolerationSeconds": { "type": "integer", "minimum": 0 },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "platformImage": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string" }
      }
    },
    "throttleRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "limit"],
      "properties": {
        "window": { "description": "Measurement window duration.", "type": "string", "minLength": 1 },
        "limit": { "description": "Maximum requests in the window.", "type": "integer", "minimum": 1 }
      }
    },
    "throttleCooldownScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "limit", "cooldown"],
      "properties": {
        "window": { "description": "Failure measurement window duration.", "type": "string", "minLength": 1 },
        "limit": { "description": "Maximum failures in the window.", "type": "integer", "minimum": 1 },
        "cooldown": { "description": "Block duration after the limit is reached.", "type": "string", "minLength": 1 }
      }
    },
    "loginAuthThrottle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "source", "account", "sourceAccount"],
      "properties": {
        "route": { "$ref": "#/definitions/throttleRoute" },
        "source": { "$ref": "#/definitions/throttleCooldownScope" },
        "account": { "$ref": "#/definitions/throttleCooldownScope" },
        "sourceAccount": { "$ref": "#/definitions/throttleCooldownScope" }
      }
    },
    "subjectAuthThrottle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "source", "subject", "sourceSubject"],
      "properties": {
        "route": { "$ref": "#/definitions/throttleRoute" },
        "source": { "$ref": "#/definitions/throttleCooldownScope" },
        "subject": { "$ref": "#/definitions/throttleCooldownScope" },
        "sourceSubject": { "$ref": "#/definitions/throttleCooldownScope" }
      }
    }
  }
}

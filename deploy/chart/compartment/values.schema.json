{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "required": [
        "startupStage",
        "installationId",
        "domainMode",
        "baseDomain",
        "publicProtocol",
        "tlsMode",
        "publicIngressIpv4",
        "publicIngressIpv6",
        "acmeIssuer",
        "acmeCaUrl",
        "acmeEmail",
        "managedDomainBrokerUrl"
      ],
      "properties": {
        "startupStage": { "type": "string", "enum": ["foundation", "full"] },
        "installationId": { "type": "string" },
        "domainMode": { "type": "string", "enum": ["custom", "managed"] },
        "baseDomain": { "type": "string" },
        "publicProtocol": { "type": "string", "enum": ["http", "https"] },
        "tlsMode": { "type": "string", "enum": ["custom-cert", "custom-http", "internal", "managed"] },
        "publicIngressIpv4": {
          "oneOf": [{ "const": "" }, { "type": "string", "format": "ipv4" }]
        },
        "publicIngressIpv6": {
          "oneOf": [{ "const": "" }, { "type": "string", "format": "ipv6" }]
        },
        "acmeIssuer": { "type": "string", "enum": ["acme"] },
        "acmeCaUrl": { "type": "string", "pattern": "^https://[^/?#@]+(/[^?#]*)?$" },
        "acmeEmail": { "type": "string" },
        "managedDomainBrokerUrl": {
          "oneOf": [{ "const": "" }, { "type": "string", "pattern": "^https?://[^/?#@]+/?$" }]
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "installToken": { "type": "string" },
        "managedDomainBrokerToken": { "type": "string" }
      }
    },
    "customTls": {
      "type": "object",
      "required": ["existingSecret", "certificate", "privateKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "certificate": { "type": "string" },
        "privateKey": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "caddy": {
          "type": "object",
          "required": ["type", "httpPort", "httpsPort"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
            "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "httpsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "httpNodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "httpsNodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "buildkit": {
      "type": "object",
      "required": [
        "enabled",
        "namespace",
        "gcKeepStorageMb",
        "pruneSchedule",
        "pruneKeepDuration",
        "podCidr",
        "serviceCidr"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "gcKeepStorageMb": { "type": "integer", "minimum": 1 },
        "pruneSchedule": { "type": "string", "minLength": 1 },
        "pruneKeepDuration": { "type": "string", "minLength": 1 },
        "workerNamespaceSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "workerPodSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "dnsNamespaceSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "dnsPodSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "podCidr": { "type": "string", "minLength": 1 },
        "serviceCidr": { "type": "string", "minLength": 1 },
        "seccompProfile": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "properties": {
        "snapshots": {
          "type": "object",
          "required": ["enabled", "mountPath"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": { "edgeSnapshots": { "type": "string", "minLength": 1 } }
    }
  }
}

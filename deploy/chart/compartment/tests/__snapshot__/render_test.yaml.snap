  1: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: caddy
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: renamed-compartment-caddy
    spec:
      ports:
        - name: http
          port: 80
          targetPort: http
        - name: https
          port: 443
          targetPort: https
      selector:
        app.kubernetes.io/component: caddy
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/name: compartment
      type: LoadBalancer
  2: |

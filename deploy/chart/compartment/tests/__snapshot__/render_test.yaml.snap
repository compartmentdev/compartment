  5: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      labels:
        app.kubernetes.io/component: api-migrate
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-api-migrate-0
    spec:
      backoffLimit: 12
      template:
        metadata:
          labels:
            app.kubernetes.io/component: api-migrate
            app.kubernetes.io/instance: compartment
            app.kubernetes.io/name: compartment
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - node
                - dist/db/migrate.js
              env:
                - name: COMPARTMENT_DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      key: database-url
                      name: compartment-compartment
              image: ghcr.io/compartmentdev/compartment-api:latest
              imagePullPolicy: IfNotPresent
              name: api-migrate
              resources:
                limits:
                  cpu: 500m
                  memory: 512Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 10001
                runAsNonRoot: true
                runAsUser: 10001
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          initContainers:
            - args:
                - wait
                - --for=condition=available
                - deployment/compartment-compartment-postgres
                - deployment/compartment-compartment-registry
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-foundation
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
          restartPolicy: OnFailure
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: compartment-compartment-waiter
          volumes:
            - name: kube-api-access
              projected:
                defaultMode: 420
                sources:
                  - serviceAccountToken:
                      expirationSeconds: 3600
                      path: token
                  - configMap:
                      items:
                        - key: ca.crt
                          path: ca.crt
                      name: kube-root-ca.crt
                  - downwardAPI:
                      items:
                        - fieldRef:
                            apiVersion: v1
                            fieldPath: metadata.namespace
                          path: namespace
            - emptyDir: {}
              name: tmp

      name: compartment-compartment-caddy
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: caddy
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/config: 049bd529325935ce71f4db3667b0f09d2ce7cebf5398bdcf1f584d8e0c9e37fe
            checksum/custom-tls: 01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b

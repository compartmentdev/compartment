                readOnlyRootFilesystem: true
                runAsGroup: 999
                runAsNonRoot: true
                runAsUser: 999
              volumeMounts:
                - mountPath: /var/lib/postgresql/data
                  name: data
                - mountPath: /var/run
                  name: run
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 999
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: compartment-compartment-postgres
            - emptyDir: {}
              name: run
            - emptyDir: {}
              name: tmp

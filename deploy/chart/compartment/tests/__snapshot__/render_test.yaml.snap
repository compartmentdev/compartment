                - containerPort: 8686
                  name: api
                - containerPort: 9598
                  name: metrics
              readinessProbe:
                httpGet:
                  path: /health
                  port: api
                periodSeconds: 5
                timeoutSeconds: 2
              resources:
                limits:
                  cpu: "1"
                  ephemeral-storage: 384Mi
                  memory: 256Mi
                requests:
                  cpu: 50m
                  ephemeral-storage: 320Mi
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: false
                runAsUser: 0
              volumeMounts:
                - mountPath: /etc/vector
                  name: config
                  readOnly: true
                - mountPath: /var/log/pods
                  name: pod-logs
                  readOnly: true
                - mountPath: /var/lib/vector
                  name: data
          serviceAccountName: compartment-compartment-log-agent
          terminationGracePeriodSeconds: 30
          volumes:
            - configMap:
                name: compartment-compartment-log-agent
              name: config
            - hostPath:
                path: /var/log/pods
                type: Directory
              name: pod-logs
            - hostPath:
                path: /var/lib/compartment/compartment-compartment-log-agent
                type: DirectoryOrCreate
              name: data

                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 2
              resources:
                limits:
                  cpu: 500m
                  memory: 384Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000

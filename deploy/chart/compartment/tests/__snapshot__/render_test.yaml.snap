                - name: COMPARTMENT_WORKER_SERVICE_ACCOUNT_NAME
                  value: compartment-compartment-worker
              envFrom:
                - configMapRef:
                    name: compartment-compartment
              image: ghcr.io/compartmentdev/compartment-worker:latest
              imagePullPolicy: IfNotPresent
              name: project-provisioner
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 10001
                runAsNonRoot: true
                runAsUser: 10001
              volumeMounts:
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
          initContainers:
            - args:
                - wait
                - --for=condition=complete
                - job/compartment-compartment-api-migrate-0
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-migrate
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
            - args:
                - rollout
                - status
                - deployment/compartment-compartment-api
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-rollout
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL

  14: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: buildkit
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-buildkit
      namespace: compartment-build
    spec:
      progressDeadlineSeconds: 45
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: buildkit
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/component: buildkit
            app.kubernetes.io/instance: compartment
            app.kubernetes.io/name: compartment
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --addr
                - tcp://0.0.0.0:1234
                - --oci-worker-no-process-sandbox
                - --oci-worker-gc-keepstorage
                - "2000"
              env:
                - name: HOME
                  value: /home/user
                - name: XDG_RUNTIME_DIR
                  value: /run/user/1000
              image: moby/buildkit:v0.30.0-rootless
              imagePullPolicy: IfNotPresent
              name: buildkit
              ports:
                - containerPort: 1234
                  name: buildkit
              readinessProbe:
                periodSeconds: 2
                tcpSocket:
                  port: buildkit
              resources:
                limits:
                  cpu: "2"
                  memory: 2Gi
                requests:
                  cpu: 250m
                  memory: 512Mi
              securityContext:
                allowPrivilegeEscalation: true
                appArmorProfile:
                  type: Unconfined
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /home/user/.local/share/buildkit
                  name: data
                - mountPath: /home/user/.local/tmp
                  name: rootless-tmp
                - mountPath: /run/user/1000
                  name: run
                - mountPath: /tmp
                  name: tmp
                - mountPath: /home/user/.docker/config.json
                  name: registry-auth
                  readOnly: true
                  subPath: .dockerconfigjson
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: Unconfined
          terminationGracePeriodSeconds: 45
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: compartment-compartment-buildkit
            - name: registry-auth
              secret:
                secretName: compartment-compartment-registry-client
            - emptyDir: {}
              name: run
            - emptyDir: {}
              name: rootless-tmp
            - emptyDir: {}
              name: tmp
  15: |
    apiVersion: batch/v1
    kind: CronJob
    metadata:
      labels:
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-buildkit-prune
      namespace: compartment-build
    spec:
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/component: buildkit-prune
                app.kubernetes.io/instance: compartment
                app.kubernetes.io/name: compartment
            spec:
              automountServiceAccountToken: false
              containers:
                - args:
                    - --addr
                    - tcp://compartment-compartment-buildkit:1234
                    - prune
                    - --all
                    - --keep-duration
                    - 24h
                    - --keep-storage
                    - "2000"
                  command:
                    - buildctl
                  image: moby/buildkit:v0.30.0-rootless
                  imagePullPolicy: IfNotPresent
                  name: prune
                  resources:
                    limits:
                      cpu: 100m
                      memory: 128Mi
                    requests:
                      cpu: 50m
                      memory: 64Mi
                  securityContext:
                    allowPrivilegeEscalation: false
                    capabilities:
                      drop:
                        - ALL
                    readOnlyRootFilesystem: true
                    runAsNonRoot: true
              restartPolicy: OnFailure
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
      schedule: 0 3 * * *

        app.kubernetes.io/component: postgres
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/name: compartment
  5: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: postgres
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: renamed-compartment-postgres
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: postgres
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/secret: 64c882079eff309d8de19646496afcb3946701a062f48312373c6f937a66f8ca
          labels:
            app.kubernetes.io/component: postgres
            app.kubernetes.io/instance: compartment
            app.kubernetes.io/name: compartment
        spec:
          containers:
            - env:
                - name: POSTGRES_DB
                  value: compartment
                - name: POSTGRES_USER
                  value: postgres
                - name: POSTGRES_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: postgres-password
                      name: renamed-compartment
                - name: PGDATA
                  value: /var/lib/postgresql/data/pgdata
              image: postgres:16
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - pg_isready
                    - -U
                    - postgres
                    - -d
                    - compartment
                initialDelaySeconds: 10
                periodSeconds: 10
              name: postgres
              ports:
                - containerPort: 5432
                  name: postgres
              readinessProbe:
                exec:
                  command:
                    - pg_isready
                    - -U
                    - postgres
                    - -d
                    - compartment
                periodSeconds: 2
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 999
                runAsNonRoot: true
                runAsUser: 999
              volumeMounts:
                - mountPath: /var/lib/postgresql/data
                  name: data
                - mountPath: /var/run
                  name: run
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 999
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: renamed-compartment-postgres
            - emptyDir: {}
              name: run
            - emptyDir: {}
              name: tmp

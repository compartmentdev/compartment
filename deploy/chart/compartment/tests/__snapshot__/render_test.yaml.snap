            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
              - DELETE
            resources:
              - clusterrolebindings
            scope: Cluster
      validations:
        - expression: request.resource.resource != 'namespaces' || request.userInfo.username == 'system:serviceaccount:compartment-compartment-project-provisioning:' + object.metadata.name
          message: Project bootstrap authority is restricted to its encoded target namespace.
        - expression: 'request.resource.resource != ''rolebindings'' || (request.userInfo.username.startsWith(''system:serviceaccount:compartment-compartment-project-provisioning:cpt-'') && request.userInfo.username == ''system:serviceaccount:compartment-compartment-project-provisioning:'' + request.namespace && (request.operation == ''DELETE'' ? request.name == ''compartment-project-bootstrap'' : object.roleRef.apiGroup == ''rbac.authorization.k8s.io'' && object.roleRef.kind == ''ClusterRole'' && object.roleRef.name == ''compartment-controller'' && (object.metadata.name == ''compartment-project-bootstrap'' ? object.subjects.size() == 2 && object.subjects.exists(subject, subject.kind == ''ServiceAccount'' && subject.namespace == ''compartment-compartment-project-provisioning'' && request.userInfo.username == ''system:serviceaccount:'' + subject.namespace + '':'' + subject.name) && object.subjects.exists(subject, subject.kind == ''ServiceAccount'' && subject.namespace == ''NAMESPACE'' && subject.name == ''compartment-compartment-worker'') : object.metadata.name == ''compartment-controller'' && object.subjects.size() == 1 && object.subjects.all(subject, subject.kind == ''ServiceAccount'' && subject.namespace == ''NAMESPACE'' && subject.name == ''compartment-compartment-worker''))))'
          message: Project bootstrap authority may manage only canonical controller RoleBindings.
        - expression: 'request.resource.resource != ''clusterrolebindings'' || (request.operation == ''DELETE'' ? request.name == ''compartment-project-bootstrap'' : request.userInfo.username == ''system:serviceaccount:NAMESPACE:compartment-compartment-project-provisioner'' && object.metadata.name == ''compartment-project-bootstrap'' && object.roleRef.apiGroup == ''rbac.authorization.k8s.io'' && object.roleRef.kind == ''ClusterRole'' && object.roleRef.name == ''compartment-project-bootstrap'' && object.subjects.size() == 1 && object.subjects.all(subject, subject.kind == ''ServiceAccount'' && subject.namespace == ''compartment-compartment-project-provisioning'' && subject.name.startsWith(''cpt-'')))'
          message: Project provisioner may manage only the canonical short-lived bootstrap ClusterRoleBinding.

        app.kubernetes.io/component: registry
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-registry
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: registry
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/component: registry
            app.kubernetes.io/instance: compartment
            app.kubernetes.io/name: compartment
        spec:
          containers:
            - env:
                - name: REGISTRY_HTTP_ADDR
                  value: 0.0.0.0:5000
                - name: REGISTRY_HTTP_RELATIVEURLS
                  value: "true"
                - name: REGISTRY_STORAGE_DELETE_ENABLED
                  value: "true"
              image: registry:2
              imagePullPolicy: IfNotPresent
              name: registry
              ports:
                - containerPort: 5000
                  name: http
              readinessProbe:
                httpGet:
                  path: /v2/
                  port: http
                periodSeconds: 2
              resources:
                limits:
                  cpu: 500m
                  memory: 512Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /var/lib/registry
                  name: data
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: compartment-compartment-registry
            - emptyDir: {}
              name: tmp
  10: |
    apiVersion: v1
    kind: Secret
    metadata:
      labels:
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment
    stringData:
      database-url: postgresql://postgres:test-postgres-password@compartment-compartment-postgres:5432/compartment
      edge-token: test-edge-token
      install-token: test-install-token
      postgres-password: test-postgres-password
      product-log-ingest-token: test-product-log-token
      registry-read-password: test-registry-read-password
      registry-write-password: test-registry-write-password
      runtime-control-token: test-runtime-control-token
      session-secret: test-session-secret
      system-token: test-system-token
      variables-master-key: test-variables-master-key
    type: Opaque

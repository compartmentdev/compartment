          targetPort: https
      selector:
        app.kubernetes.io/component: caddy
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/name: compartment
      type: LoadBalancer
  17: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: caddy
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-caddy
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: caddy
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/config: 95a9a2b06cdd7b0b618ffb995014c6515d1d3154440d032fdd3f8b595db8e996
            checksum/custom-tls: 01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b
            checksum/domain-config: b8876fc1adf22a77f1b5ac0aabc435f62ad57866e409b41cd1726ecba316bdf7
            checksum/install-state: 735badd27fbefab048510d85852a32a430075204472832235bad3d2682304a3d

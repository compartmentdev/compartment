            - command:
                - /bin/sh
                - -ec
                - exec /work/caddy run --config "/etc/caddy/Caddyfile.${COMPARTMENT_CADDY_TLS_MODE}" --adapter caddyfile
              env:
                - name: COMPARTMENT_MANAGED_DOMAIN_BROKER_TOKEN

        app.kubernetes.io/name: compartment
        helm.sh/chart: compartment-0.1.0
      name: compartment-compartment-project-bootstrap-boundary
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: request.userInfo.username.startsWith('system:serviceaccount:compartment-compartment-project-provisioning:cpt-') || request.userInfo.username == 'system:serviceaccount:NAMESPACE:compartment-compartment-project-provisioner'
          name: provisioning-identity
      matchConstraints:
        resourceRules:

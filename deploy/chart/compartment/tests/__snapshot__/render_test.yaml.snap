                  name: http
                - containerPort: 8443
                  name: https
              readinessProbe:
                periodSeconds: 2
                tcpSocket:
                  port: http
              resources:
                limits:
                  cpu: 500m
                  memory: 256Mi
                requests:
                  cpu: 25m
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /work

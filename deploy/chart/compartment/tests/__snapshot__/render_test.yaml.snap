      COMPARTMENT_ARTIFACT_REGISTRY_HOST: renamed-compartment-registry-auth.NAMESPACE.svc
      COMPARTMENT_ARTIFACT_REGISTRY_INTERNAL_HOST: renamed-compartment-registry-auth.NAMESPACE.svc

                appArmorProfile:
                  type: Unconfined
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /home/user/.local/share/buildkit
                  name: data
                - mountPath: /home/user/.local/tmp
                  name: rootless-tmp
                - mountPath: /run/user/1000
                  name: run
                - mountPath: /tmp
                  name: tmp
                - mountPath: /home/user/.docker/config.json
                  name: registry-auth
                  readOnly: true
                  subPath: .dockerconfigjson
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: Unconfined
          terminationGracePeriodSeconds: 45
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: compartment-compartment-buildkit
            - name: registry-auth
              secret:
                secretName: compartment-compartment-registry-client
            - emptyDir: {}
              name: run
            - emptyDir: {}
              name: rootless-tmp
            - emptyDir: {}
              name: tmp

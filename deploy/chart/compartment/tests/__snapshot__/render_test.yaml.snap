      egress:
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
          to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
        - ports:
            - port: 1234
              protocol: TCP
          to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/component: buildkit
                  app.kubernetes.io/instance: compartment
                  app.kubernetes.io/name: compartment
      podSelector:
        matchLabels:
          app.kubernetes.io/component: buildkit-prune
          app.kubernetes.io/instance: compartment

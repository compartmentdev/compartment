          containers:
            - env:
                - name: COMPARTMENT_EDGE_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: edge-token
                      name: compartment-compartment
                - name: COMPARTMENT_EDGE_SNAPSHOT_PATH
                  value: /var/lib/compartment/snapshots/access-state.json
              envFrom:
                - configMapRef:
                    name: compartment-compartment
              image: ghcr.io/compartmentdev/compartment-edge:latest
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
                initialDelaySeconds: 10
                periodSeconds: 10
              name: edge
              ports:
                - containerPort: 39081
                  name: http
              readinessProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 2
              resources:
                limits:
                  cpu: 500m
                  memory: 384Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/lib/compartment/snapshots
                  name: snapshots
          initContainers:
            - command:
                - sh
                - -c
                - chown -R 1000:1000 /var/lib/compartment/snapshots
              image: ghcr.io/compartmentdev/compartment-edge:latest
              imagePullPolicy: IfNotPresent
              name: snapshots-ownership
              securityContext:
                runAsGroup: 0
                runAsUser: 0
              volumeMounts:
                - mountPath: /var/lib/compartment/snapshots
                  name: snapshots
            - args:
                - wait
                - --for=condition=complete
                - job/compartment-compartment-api-migrate-0
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-migrate
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: compartment-compartment-waiter
          volumes:
            - name: kube-api-access
              projected:
                defaultMode: 420
                sources:
                  - serviceAccountToken:
                      expirationSeconds: 3600
                      path: token
                  - configMap:
                      items:
                        - key: ca.crt
                          path: ca.crt
                      name: kube-root-ca.crt
                  - downwardAPI:
                      items:
                        - fieldRef:
                            apiVersion: v1
                            fieldPath: metadata.namespace
                          path: namespace
            - emptyDir: {}
              name: tmp
            - emptyDir: {}
              name: snapshots

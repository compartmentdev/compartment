                  port: http
                periodSeconds: 2
              resources:
                limits:
                  cpu: "1"
                  memory: 768Mi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 10001
                runAsNonRoot: true
                runAsUser: 10001
              volumeMounts:
                - mountPath: /var/lib/compartment
                  name: data
                - mountPath: /var/run/compartment
                  name: runtime
                - mountPath: /tmp
                  name: tmp
          initContainers:
            - args:
                - wait
                - --for=condition=complete
                - job/compartment-compartment-api-migrate-0
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-migrate
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
          securityContext:
            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: compartment-compartment-waiter
          volumes:
            - name: kube-api-access

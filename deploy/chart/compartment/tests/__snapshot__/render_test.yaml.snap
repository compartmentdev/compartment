        app.kubernetes.io/component: caddy
        app.kubernetes.io/instance: compartment
        app.kubernetes.io/name: compartment
      type: LoadBalancer
  2: |
    apiVersion: v1
    data:
      BUILDKIT_ADDR: tcp://compartment-compartment-buildkit.compartment-build.svc:1234
      COMPARTMENT_ACME_CA_URL: https://acme.zerossl.com/v2/DV90
      COMPARTMENT_ACME_EMAIL: ""
      COMPARTMENT_ACME_ISSUER: acme
      COMPARTMENT_API_BIND_HOST: 0.0.0.0
      COMPARTMENT_API_INTERNAL_HOST: compartment-compartment-api
      COMPARTMENT_API_PORT: "39444"
      COMPARTMENT_ARTIFACT_REGISTRY_HOST: compartment-compartment-registry-auth.NAMESPACE.svc
      COMPARTMENT_ARTIFACT_REGISTRY_INTERNAL_HOST: compartment-compartment-registry-auth.NAMESPACE.svc
      COMPARTMENT_ARTIFACT_REGISTRY_INTERNAL_PORT: "5000"
      COMPARTMENT_ARTIFACT_REGISTRY_INTERNAL_URL: http://compartment-compartment-registry-auth.NAMESPACE.svc:5000
      COMPARTMENT_ARTIFACT_REGISTRY_MODE: bundled
      COMPARTMENT_ARTIFACT_REGISTRY_PORT: "5000"
      COMPARTMENT_ARTIFACT_REGISTRY_READ_USERNAME: compartment-reader
      COMPARTMENT_ARTIFACT_REGISTRY_WRITE_USERNAME: compartment-writer
      COMPARTMENT_AUDIT_FILE_SINK_DIR: /var/lib/compartment/audit-logs
      COMPARTMENT_AUDIT_FILE_SINK_ENABLED: "false"
      COMPARTMENT_AUDIT_FILE_SINK_RETENTION_FILES: "30"
      COMPARTMENT_AUDIT_FILE_SINK_ROTATE_INTERVAL: 1d
      COMPARTMENT_AUDIT_FILE_SINK_ROTATE_SIZE: 64M
      COMPARTMENT_AUDIT_RETENTION_CLEANUP_BATCH_SIZE: "1000"
      COMPARTMENT_AUDIT_RETENTION_CLEANUP_CRON: 0 3 * * *
      COMPARTMENT_AUDIT_RETENTION_CLEANUP_MAX_BATCHES: "100"
      COMPARTMENT_AUDIT_RETENTION_DAYS: "90"
      COMPARTMENT_BASE_DOMAIN: localhost
      COMPARTMENT_CADDY_HTTP_PORT: "8080"
      COMPARTMENT_CADDY_HTTPS_PORT: "8443"
      COMPARTMENT_CADDY_TLS_MODE: custom-http
      COMPARTMENT_CUSTOM_TLS_CERT_FILE: /etc/compartment/tls/fullchain.pem
      COMPARTMENT_CUSTOM_TLS_DIR: /etc/compartment/tls
      COMPARTMENT_CUSTOM_TLS_KEY_FILE: /etc/compartment/tls/privkey.pem
      COMPARTMENT_EDGE_BIND_HOST: 0.0.0.0
      COMPARTMENT_EDGE_INTERNAL_HOST: compartment-compartment-edge
      COMPARTMENT_EDGE_PORT: "39081"
      COMPARTMENT_ENV: self-hosted
      COMPARTMENT_LOG_LEVEL: info
      COMPARTMENT_MANAGED_DOMAIN_BROKER_URL: ""

              image: ghcr.io/compartmentdev/compartment-caddy:latest
              imagePullPolicy: IfNotPresent
              name: prepare-caddy
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m

    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: project-provisioner
          app.kubernetes.io/instance: compartment
          app.kubernetes.io/name: compartment
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/config: daa3824de64750c5b820f8189000355793c999c4223da377b05fbff14a78db64
            checksum/secret: 249947cf9160249bc9d472bcac9b3fd9d53aeae5e58a04263a0545a9b18cbdab
            compartment.dev/rollout-marker: ""
          labels:
            app.kubernetes.io/component: project-provisioner
            app.kubernetes.io/instance: compartment
            app.kubernetes.io/name: compartment
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - node
                - dist/project-provisioner-server.js
              env:
                - name: COMPARTMENT_ARTIFACT_REGISTRY_READ_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: registry-read-password
                      name: compartment-compartment
                - name: COMPARTMENT_ARTIFACT_REGISTRY_WRITE_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: registry-write-password
                      name: compartment-compartment
                - name: COMPARTMENT_RUNTIME_CONTROL_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: runtime-control-token
                      name: compartment-compartment
                - name: COMPARTMENT_EDGE_NAMESPACE
                  value: NAMESPACE
                - name: COMPARTMENT_KUBE_POD_CIDR
                  value: 10.42.0.0/16
                - name: COMPARTMENT_KUBE_SERVICE_CIDR
                  value: 10.43.0.0/16
                - name: COMPARTMENT_PLATFORM_NAMESPACE
                  value: NAMESPACE
                - name: COMPARTMENT_PROVISIONING_NAMESPACE
                  value: compartment-compartment-project-provisioning
                - name: COMPARTMENT_PROJECT_PROVISIONER_IMAGE
                  value: ghcr.io/compartmentdev/compartment-worker:latest
                - name: COMPARTMENT_WORKER_SERVICE_ACCOUNT_NAME
                  value: compartment-compartment-worker
              envFrom:
                - configMapRef:
                    name: compartment-compartment
              image: ghcr.io/compartmentdev/compartment-worker:latest
              imagePullPolicy: IfNotPresent
              name: project-provisioner
              resources:
                limits:
                  cpu: "1"
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 10001
                runAsNonRoot: true
                runAsUser: 10001
              volumeMounts:
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
          initContainers:
            - args:
                - wait
                - --for=condition=complete
                - job/compartment-compartment-api-migrate-0
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-migrate
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
            - args:
                - rollout
                - status
                - deployment/compartment-compartment-api
                - --timeout=6m
              command:
                - kubectl
              env:
                - name: HOME
                  value: /tmp
              image: registry.k8s.io/kubectl:v1.36.2
              imagePullPolicy: IfNotPresent
              name: wait-for-api-rollout
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
            - args:
                - |
                  const url = `http://${process.env.COMPARTMENT_API_INTERNAL_HOST}:${process.env.COMPARTMENT_API_PORT}/readyz`;
                  const deadline = Date.now() + 360000;
                  const wait = async () => {
                    try {
                      const response = await fetch(url, {signal: AbortSignal.timeout(2000)});
                      if (response.ok) process.exit(0);
                    } catch {}
                    if (Date.now() >= deadline) {
                      console.error(`Timed out waiting for ${url}`);
                      process.exit(1);
                    }
                    setTimeout(wait, 1000);
                  };
                  void wait();
              command:
                - node
                - -e
              env:
                - name: HOME
                  value: /tmp
              envFrom:
                - configMapRef:
                    name: compartment-compartment
              image: ghcr.io/compartmentdev/compartment-worker:latest
              imagePullPolicy: IfNotPresent
              name: wait-for-api
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 10001
                runAsNonRoot: true
                runAsUser: 10001
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: compartment-compartment-project-provisioner
          volumes:
            - name: kube-api-access
              projected:
                defaultMode: 420
                sources:
                  - serviceAccountToken:
                      expirationSeconds: 3600
                      path: token
                  - configMap:
                      items:
                        - key: ca.crt
                          path: ca.crt
                      name: kube-root-ca.crt
                  - downwardAPI:
                      items:
                        - fieldRef:
                            apiVersion: v1
                            fieldPath: metadata.namespace
                          path: namespace
            - emptyDir: {}
              name: tmp
